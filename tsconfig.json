{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": [
    ".agents/**/*.md",
    "config/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "steps/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "global-setup.ts",
    "playwright.config.ts"
  ]
}
